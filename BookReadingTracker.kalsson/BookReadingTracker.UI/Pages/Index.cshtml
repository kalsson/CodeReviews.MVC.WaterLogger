@page
@model IndexModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="row mb-5">
    <div class="col-12">
        <h1 class="text-center text-white">Book Reading Tracker</h1>
    </div>
</div>

<div class="row mb-3">
    <div class="col-12">
        <a class="btn btn-success" asp-area="" asp-page="/Create">Add Book</a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                <tr>
                    <th class="text-white">Title</th>
                    <th class="text-white">Author</th>
                    <th class="text-white">Pages Read</th>
                    <th class="text-white">Total Pages</th>
                    <th class="text-white">Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td class="text-white">@book.Title</td>
                        <td class="text-white">@book.Author</td>
                        <td class="text-white">@book.PagesRead</td>
                        <td class="text-white">@book.TotalPages</td>
                        <td class="text-white">
                            <a class="btn btn-primary" asp-page="/Edit" asp-route-id="@book.Id">Edit</a>
                            <a class="btn btn-danger" asp-page="/Delete" asp-route-id="@book.Id">Delete</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 d-flex justify-content-between">
        <!-- Previous Button -->
        @if (Model.CurrentPage > 1)
        {
            <a asp-page="Index" asp-route-currentPage="@(Model.CurrentPage - 1)" class="btn btn-secondary">Previous</a>
        }

        <!-- Simple pagination info -->
        <span class="text-white align-self-center">Page @Model.CurrentPage of @Model.TotalPages</span>

        <!-- Next Button -->
        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a asp-page="Index" asp-route-currentPage="@(Model.CurrentPage + 1)" class="btn btn-secondary">Next</a>
        }
    </div>
</div>