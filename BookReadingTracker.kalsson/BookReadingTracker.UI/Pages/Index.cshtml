@page
@model IndexModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="row mb-5">
    <div class="col-12">
        <h1 class="text-center text-white">Book Reading Tracker</h1>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <table class="table">
            <thead>
            <tr>
                <th class="text-white">Title</th>
                <th class="text-white">Author</th>
                <th class="text-white">Pages Read</th>
                <th class="text-white">Total Pages</th>
                <th class="text-white">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td class="text-white">@book.Title</td>
                    <td class="text-white">@book.Author</td>
                    <td class="text-white">@book.PagesRead</td>
                    <td class="text-white">@book.TotalPages</td>
                    <td class="text-white">
                        <a class="btn btn-primary" asp-page="/Edit" asp-route-id="@book.Id">Edit</a>
                        <a class="btn btn-danger" asp-page="/Delete" asp-route-id="@book.Id">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <a class="btn btn-success" asp-area="" asp-page="/Create">Add Book</a>
    </div>
</div>