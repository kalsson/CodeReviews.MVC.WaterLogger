@page "{id:int}"
@model DeleteModel
@{
    ViewData["Title"] = "Delete Book";
}

<div class="row mb-5">
    <div class="col-12">
        <h1 class="text-center text-white">Delete Book</h1>
    </div>
</div>

<div>
    <h3 class="text-white">Are you sure you want to delete this book?</h3>
    <div>
        <dl class="row">
            <dt class="col-sm-2 text-white">Title</dt>
            <dd class="col-sm-10 text-white">@Model.Book.Title</dd>
            <dt class="col-sm-2 text-white">Author</dt>
            <dd class="col-sm-10 text-white">@Model.Book.Author</dd>
        </dl>
    </div>

    <form method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a class="btn btn-secondary" asp-page="/Index">Cancel</a>
    </form>
</div>