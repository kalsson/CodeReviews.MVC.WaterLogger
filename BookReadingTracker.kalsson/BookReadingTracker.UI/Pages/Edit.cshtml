@page "{id:int}"
@model EditModel
@{
    ViewData["Title"] = "Edit Book";
}

<h1>Edit Book</h1>

<form method="post">
    <input type="hidden" asp-for="Book.Id" />
    <div class="form-group">
        <label asp-for="Book.Title" class="form-label"></label>
        <input asp-for="Book.Title" class="form-control" />
        <span asp-validation-for="Book.Title" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Book.Author" class="form-label"></label>
        <input asp-for="Book.Author" class="form-control" />
        <span asp-validation-for="Book.Author" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Book.PagesRead" class="form-label"></label>
        <input asp-for="Book.PagesRead" class="form-control" />
        <span asp-validation-for="Book.PagesRead" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Book.TotalPages" class="form-label"></label>
        <input asp-for="Book.TotalPages" class="form-control" />
        <span asp-validation-for="Book.TotalPages" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>

<a class="btn btn-secondary" asp-page="/Index">Cancel</a>