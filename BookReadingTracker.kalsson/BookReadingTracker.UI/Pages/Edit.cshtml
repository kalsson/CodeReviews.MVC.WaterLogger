@page "{id:int}"
@using BookReadingTracker.UI.Models
@model EditModel
@{
    ViewData["Title"] = "Edit Book";
}

<div class="row mb-5">
    <div class="col-12">
        <h1 class="text-center text-white">Edit Book</h1>
    </div>
</div>

<form method="post">
    <input type="hidden" asp-for="Book.Id" />
    <div class="form-group">
        <label asp-for="Book.Title" class="form-label text-white"></label>
        <input asp-for="Book.Title" class="form-control bg-transparent text-white" />
        <span asp-validation-for="Book.Title" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Book.Author" class="form-label text-white"></label>
        <input asp-for="Book.Author" class="form-control bg-transparent text-white" />
        <span asp-validation-for="Book.Author" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Book.PagesRead" class="form-label text-white"></label>
        <input asp-for="Book.PagesRead" class="form-control bg-transparent text-white" />
        <span asp-validation-for="Book.PagesRead" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Book.TotalPages" class="form-label text-white"></label>
        <input asp-for="Book.TotalPages" class="form-control bg-transparent text-white" />
        <span asp-validation-for="Book.TotalPages" class="text-danger"></span>
    </div>
</form>

<div class="row mt-3">
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a class="btn btn-secondary" asp-page="/Index">Cancel</a>
    </div>
</div>